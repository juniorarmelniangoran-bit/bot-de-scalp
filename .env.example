# Copie tes cles dans un fichier HORS du projet (ex ~/secrets/bot.env) et pointe BOT_ENV_FILE vers lui.
# Ne mets JAMAIS tes vraies cles dans le dossier du projet (dossier synchro cloud). Ce fichier n'est qu'un exemple sans valeurs.
# Le code charge BOT_ENV_FILE via python-dotenv (recorder/config.py:load_bot_env_file).
# Exemple portable (Linux/Windows via pathlib) : BOT_ENV_FILE=~/secrets/bot.env
# Sur Windows tu peux aussi utiliser un dossier hors projet comme %USERPROFILE%/secrets/bot.env
BOT_ENV_FILE=~/secrets/bot.env
CAPITAL_API_KEY=
CAPITAL_IDENTIFIER=
CAPITAL_PASSWORD=
CAPITAL_ENV=demo
ALLOW_LIVE=false
DATABENTO_API_KEY=
